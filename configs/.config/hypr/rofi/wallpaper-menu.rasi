/* wallpaper-menu.rasi — MONOLITH: grafite + ciano, cantos retos, fundo preto translúcido, borda visível.
   Troque as cores nas variáveis do bloco "*" (ex.: border-col para combinar com a borda do Hyprland). */
* {
    font:        "JetBrainsMono Nerd Font Bold 11";

    bg:          #111111d9;      /* fundo: preto translúcido (igual à Waybar) */
    fg:          #cccccc;
    fg-dim:      #888888;
    fg-sel:      #ffffff;
    sel:         #5151511a;      /* item selecionado */
    accent:      #515151;        /* ciano */
    border-col:  #ffffff;        /* borda da janela */
    line:        #c8c8c840;      /* divisórias discretas */

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         center;
    anchor:           center;
    width:            520px;
    background-color: @bg;
    border:           0px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          0px;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing:  0px;
}

inputbar {
    children:     [ "prompt", "entry" ];
    spacing:      10px;
    padding:      12px 14px;
    border:       0px 0px 1px 0px;
    border-color: @line;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    text-color:        @fg-sel;
    cursor-width:      1px;
}

listview {
    lines:        6;
    columns:      1;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
    padding:      8px;
}

element {
    padding:       8px 10px;
    border:        1px;
    border-color:  transparent;
    border-radius: 8px;
}

element selected.normal {
    background-color: @sel;
    text-color:       @fg-sel;
    border-color:     @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold #ffffff;
    vertical-align:   0.5;
}

element-icon {
    size:             1.2em;
    background-color: transparent;
    margin:           0px 10px 0px 0px;
}

message {
    padding: 8px 14px;
}
textbox {
    text-color: @fg-sel;
}
