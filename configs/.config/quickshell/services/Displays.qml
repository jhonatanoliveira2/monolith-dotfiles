pragma Singleton
import QtQuick
import "../core"
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

// Monitor manager for Settings > Display. Reads `hyprctl monitors all -j`, applies layouts through the Lua API
// (hl.monitor{} via `hyprctl eval`) and, once the user keeps them, writes ~/.config/hypr/generated/monitors.lua
// (loaded last by hyprland.lua). Every apply starts a 15 s countdown that restores the previous layout unless confirmed.
Singleton {
    id: root
    property var monitors: []        // [{name, desc, width, height, refresh, scale, transform, x, y, disabled, modes:[{w,h,r}]}]
    property string primary: ""      // cursor:default_monitor + workspace 1 default
    property var previous: null      // { monitors, primary } snapshot while a change waits for confirmation
    property int countdown: 0
    property string error: ""
    readonly property bool pending: previous !== null
    readonly property string file: Sys.hyprDir + "/generated/monitors.lua"

    function refresh() { readProc.running = true; primaryProc.running = true }

    // logical size (what positions are measured in): pixels / scale, swapped for 90° / 270°
    function logical(m) {
        const w = Math.round(m.width / m.scale), h = Math.round(m.height / m.scale)
        return m.transform % 2 === 1 ? { w: h, h: w } : { w: w, h: h }
    }
    function modeStr(m) { return m.width + "x" + m.height + "@" + Number(m.refresh).toFixed(2) }
    function spec(m) {
        if (m.disabled) return "hl.monitor({ output = \"" + m.name + "\", disabled = true })"
        return "hl.monitor({ output = \"" + m.name + "\", mode = \"" + modeStr(m) + "\", position = \"" + Math.round(m.x) + "x" + Math.round(m.y)
            + "\", scale = " + Number(m.scale) + ", transform = " + (m.transform | 0) + " })"
    }
    function primaryLua(p) {
        return p ? "hl.config({ cursor = { default_monitor = \"" + p + "\" } })\nhl.workspace_rule({ workspace = \"1\", monitor = \"" + p + "\", default = true })" : ""
    }
    // Hyprland wants every layout to start at 0x0 without overlaps: shift so the top-left monitor sits at the origin
    function normalize(list) {
        const on = list.filter(m => !m.disabled)
        if (!on.length) return list
        const mx = Math.min.apply(null, on.map(m => m.x)), my = Math.min.apply(null, on.map(m => m.y))
        return list.map(m => Object.assign({}, m, { x: Math.round(m.x - mx), y: Math.round(m.y - my) }))
    }
    function overlaps(list) {
        const on = list.filter(m => !m.disabled)
        for (let i = 0; i < on.length; i++) for (let j = i + 1; j < on.length; j++) {
            const a = on[i], b = on[j], la = logical(a), lb = logical(b)
            if (a.x < b.x + lb.w && b.x < a.x + la.w && a.y < b.y + lb.h && b.y < a.y + la.h) return true
        }
        return false
    }

    function apply(list, prim) {
        list = normalize(list)
        if (overlaps(list)) { error = Strings.t("monOverlap"); return false }
        error = ""
        if (!previous) previous = { monitors: monitors, primary: primary }
        evalLua(list.map(spec).concat([primaryLua(prim)]).join("\n"))
        monitors = list
        primary = prim
        countdown = 15
        tick.restart()
        return true
    }
    function keep() {
        tick.stop(); countdown = 0; previous = null
        mkdirProc.running = true            // then write the file
    }
    function revert() {
        tick.stop(); countdown = 0
        const p = previous
        previous = null
        if (!p) return
        evalLua(p.monitors.map(spec).concat([primaryLua(p.primary)]).join("\n"))
        monitors = p.monitors
        primary = p.primary
        refreshSoon.restart()
    }
    function writeFile() {
        genFile.setText("-- Generated by the MONOLITH Settings app (Settings > Display). Outputs listed here override\n"
            + "-- modules/monitors.lua; delete this file to go back to it.\n"
            + monitors.map(spec).join("\n") + "\n" + primaryLua(primary) + "\n")
    }

    function evalLua(code) {
        evalProc.command = Config.hyprEval.concat([code])
        evalProc.running = true
    }

    Timer {
        id: tick
        interval: 1000; repeat: true
        onTriggered: { root.countdown--; if (root.countdown <= 0) root.revert() }
    }
    Timer { id: refreshSoon; interval: 700; onTriggered: root.refresh() }
    // hot-plug while the Display page is open
    Connections {
        target: Hyprland
        function onRawEvent(event) { if (!root.pending && (event.name === "monitoraddedv2" || event.name === "monitorremovedv2")) refreshSoon.restart() }
    }

    Process {
        id: readProc
        command: ["hyprctl", "monitors", "all", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                let j
                try { j = JSON.parse(text) } catch (e) { root.error = "hyprctl monitors: " + e; return }
                root.monitors = j.map(m => ({
                    name: m.name, desc: [m.make, m.model].filter(x => x).join(" ") || m.description, width: m.width, height: m.height,
                    refresh: Math.round(m.refreshRate * 100) / 100, scale: m.scale, transform: m.transform, x: m.x, y: m.y,
                    disabled: !!m.disabled, focused: !!m.focused,
                    modes: (m.availableModes || []).map(s => {
                        const r = /^(\d+)x(\d+)@([\d.]+)Hz$/.exec(s)
                        return r ? { w: Number(r[1]), h: Number(r[2]), r: Math.round(Number(r[3]) * 100) / 100 } : null
                    }).filter(x => x)
                }))
            }
        }
    }
    Process {
        id: primaryProc
        command: ["hyprctl", "getoption", "cursor:default_monitor", "-j"]
        stdout: StdioCollector {
            onStreamFinished: { try { const s = JSON.parse(text).str; root.primary = s && s !== "[[EMPTY]]" ? s : "" } catch (e) {} }
        }
    }
    Process {
        id: evalProc
        stdout: StdioCollector { id: evalOut }
        onExited: code => { const t = evalOut.text.trim(); if (code !== 0 || (t !== "" && t !== "ok")) root.error = t || ("hyprctl " + code) }
    }
    Process {
        id: mkdirProc
        command: ["mkdir", "-p", Sys.hyprDir + "/generated"]
        onExited: code => { if (code === 0) root.writeFile(); else root.error = "mkdir " + Sys.hyprDir + "/generated" }
    }
    FileView { id: genFile; path: root.file; blockWrites: true; printErrors: false }
}
