import QtQuick
import Quickshell
import Quickshell.Io

// One PipeWire filter-chain run as its own `pipewire -c <conf>` in a persistent systemd user unit
// (~/.config/systemd/user/<unit>.service, WantedBy=pipewire.service). The unit starts with PipeWire at login,
// so the effects keep working while the shell is stopped or reloading. apply() is idempotent: an unchanged
// config on a running unit is left alone; otherwise the config is rewritten and the unit restarted, and the
// chain's virtual node becomes the default `kind` (source | sink). Turning it off disables the unit and gives
// the default back to the physical device. Used by MicFx and AudioFx.
// While the chain runs with the same node layout (`makeStructure`), value changes are sent live to the filter
// (pw-cli set-param Props on `paramNode`) and only the config file is rewritten: no restart, so playback and
// recording are not interrupted. Picking another physical device is live too: the chain's own stream
// (`streamNode`, the side linked to the device) is moved with the target.object metadata. A failed live update
// falls back to a restart.
QtObject {
    id: root
    property string tag: "fx"                // log prefix
    property string unit: ""
    property string nodeName: ""             // virtual node exposed by the chain
    property string kind: "sink"             // source | sink
    property string description: ""
    property string conf: ""
    property bool wanted: false
    property var makeTarget: () => ""        // physical device to filter
    property var makeArgs: target => ""      // filter-chain module args (SPA JSON)
    property var makeStructure: () => ""     // node layout; a change needs a restart
    property var makeParams: () => []        // [["node:Control", value], ...] for live updates
    property string paramNode: nodeName      // node.name holding the filter controls (the capture side)
    property string streamNode: ""           // node.name of the stream linked to the physical device ("" = retarget by restart)
    property string liveStructure: ""        // layout of the running chain ("" = unknown / not running)
    property string pendingStructure: ""
    property string liveTarget: ""           // physical device the running chain was started with or moved to
    property string pendingTarget: ""
    property bool active: false
    property string error: ""

    function config(target) {
        return "# generated by quickshell (services/" + tag + ") — changes are overwritten\n"
            + "context.properties = { log.level = 0 }\n"
            + "context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }\n"
            + "context.modules = [\n"
            + "  { name = libpipewire-module-rt args = { nice.level = -11 } flags = [ ifexists nofail ] }\n"
            + "  { name = libpipewire-module-protocol-native }\n"
            + "  { name = libpipewire-module-client-node }\n"
            + "  { name = libpipewire-module-adapter }\n"
            + "  { name = libpipewire-module-filter-chain\n    args = {\n" + makeArgs(target) + "    }\n  }\n]\n"
    }

    readonly property bool canLive: wanted && active && liveStructure !== "" && makeStructure() === liveStructure
    // changes are coalesced: short for live updates (heard almost at once), longer when a restart is needed
    function schedule() { timer.interval = canLive ? 120 : 700; timer.restart() }
    function apply() {
        // test instances (another XDG_STATE_HOME) must not rewrite the real units
        if (Quickshell.env("MONOLITH_NO_FX") === "1") { console.log("[" + tag + "] MONOLITH_NO_FX=1: skipped"); return }
        if (proc.running) { timer.restart(); return }
        const target = makeTarget()
        // a new physical device used to go live too and only reached the config file: the stream stayed on the old one
        const retarget = canLive && target !== liveTarget ? target : ""
        const live = canLive && (retarget === "" || streamNode !== "")
        error = ""
        pendingStructure = wanted ? makeStructure() : ""
        pendingTarget = wanted ? target : ""
        const params = live ? "{ params = [ " + makeParams().map(p => JSON.stringify(p[0]) + " " + Number(p[1]).toFixed(6)).join(" ") + " ] }" : ""
        console.log("[" + tag + "] apply: wanted=" + wanted + " mode=" + (live ? "live" : "full") + " target=" + (target || "<default>")
            + (retarget !== "" ? " (was " + (liveTarget || "<default>") + ")" : ""))
        if (wanted && target === "") console.warn("[" + tag + "] no physical " + kind + " found; the chain follows the default")
        proc.command = ["sh", "-c", script, "sh", conf, wanted ? config(target) : "", wanted ? "1" : "0", nodeName, unit, kind, target, tag, description,
                        live ? "live" : "full", paramNode, params, streamNode, live ? retarget : ""]
        proc.running = true
    }

    readonly property string script: '
        conf=$1 text=$2 on=$3 node=$4 unit=$5 kind=$6 target=$7 tag=$8 desc=$9 mode=${10} pnode=${11} params=${12} snode=${13} retarget=${14}
        nid() { pw-cli ls Node 2>/dev/null | awk -v n="$1" \'/^[[:space:]]*id [0-9]+,/ { id = $2; sub(",", "", id) } index($0, "node.name = \\"" n "\\"") { print id; exit }\'; }
        if [ "$mode" = live ]; then
            id=$(nid "$pnode")
            if [ -n "$id" ] && out=$(pw-cli set-param "$id" Props "$params" 2>&1) && ! printf "%s" "$out" | grep -qi error; then
                if [ -n "$retarget" ]; then
                    sid=$(nid "$snode") out=""
                    if [ -n "$sid" ] && out=$(pw-metadata "$sid" target.object "$retarget" 2>&1); then
                        echo "[$tag] $snode (node $sid) moved to $retarget"
                    else
                        out="cannot move $snode (node ${sid:-not found}) to $retarget: $out"; id=""
                    fi
                fi
                if [ -n "$id" ]; then
                    printf "%s" "$text" > "$conf"
                    echo "[$tag] live update on node $id ($pnode)"; exit 0
                fi
            fi
            echo "[$tag] live update failed (node ${id:-not found}): $out; restarting the chain"
        fi
        udir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
        ufile=$udir/$unit.service
        was=$(pactl get-default-$kind 2>/dev/null)
        # older versions ran the chain as a transient unit with the same name
        if [ "$(systemctl --user show -p Transient --value "$unit.service" 2>/dev/null)" = yes ]; then
            echo "[$tag] stopping the old transient unit"; systemctl --user stop "$unit.service"
        fi
        if [ "$on" != 1 ]; then
            if [ -f "$ufile" ]; then
                systemctl --user disable --now -q "$unit.service" 2>/dev/null
                rm -f "$ufile"; systemctl --user daemon-reload
                echo "[$tag] unit disabled and removed"
            fi
            rm -f "$conf"
            if [ "$was" = "$node" ] && [ -n "$target" ]; then pactl set-default-$kind "$target" && echo "[$tag] default $kind restored: $target"; fi
            echo "[$tag] off"; exit 0
        fi
        pw=$(command -v pipewire) || { echo "[$tag] pipewire not found" >&2; exit 2; }
        want=$(printf "[Unit]\nDescription=%s\nAfter=pipewire.service pipewire-pulse.service wireplumber.service\nBindsTo=pipewire.service\n\n[Service]\nExecStart=%s -c \\"%s\\"\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=pipewire.service" "$desc" "$pw" "$conf")
        if [ "$(cat "$ufile" 2>/dev/null)" != "$want" ]; then
            mkdir -p "$udir" && printf "%s\n" "$want" > "$ufile" || { echo "[$tag] cannot write $ufile" >&2; exit 3; }
            systemctl --user daemon-reload
            echo "[$tag] unit written: $ufile"
        fi
        systemctl --user is-enabled -q "$unit.service" 2>/dev/null || { systemctl --user enable -q "$unit.service" && echo "[$tag] unit enabled (starts with PipeWire)"; }
        if [ "$(cat "$conf" 2>/dev/null)" = "$(printf "%s" "$text")" ] && systemctl --user is-active -q "$unit.service"; then
            echo "[$tag] running, config unchanged"; exit 0
        fi
        printf "%s" "$text" > "$conf" || { echo "[$tag] cannot write $conf" >&2; exit 3; }
        systemctl --user restart "$unit.service" || { echo "[$tag] restart failed" >&2; exit 4; }
        echo "[$tag] config written, unit restarted"
        i=0
        while [ $i -lt 30 ]; do
            if pactl list short ${kind}s 2>/dev/null | grep -q "[[:space:]]$node[[:space:]]"; then
                pactl set-default-$kind "$node" && echo "[$tag] running; default $kind: $node (was ${was:-?})"; exit 0
            fi
            i=$((i + 1)); sleep 0.2
        done
        echo "[$tag] $node did not appear; journalctl --user -u $unit:" >&2
        journalctl --user -u "$unit" -n 8 --no-pager -o cat >&2 2>/dev/null
        exit 5'

    property Timer timer: Timer { interval: 700; onTriggered: root.apply() }
    property Process proc: Process {
        stdout: SplitParser { onRead: l => console.log(l) }
        stderr: SplitParser { onRead: l => { console.warn(l); root.error = l } }
        onExited: code => {
            root.active = code === 0 && root.wanted
            root.liveStructure = root.active ? root.pendingStructure : ""
            root.liveTarget = root.active ? root.pendingTarget : ""
            if (code !== 0) console.warn("[" + root.tag + "] apply failed with exit code", code)
        }
    }
}
