pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../core"

// Microphone effects (Settings > Microphone): RNNoise noise suppression (noise-suppression-for-voice, LADSPA)
// and a 5-band equalizer (PipeWire builtin biquads). The chain is a PipeWire filter-chain run as its own
// `pipewire -c` instance in the transient user unit monolith-micfx, so it survives shell reloads and never
// restarts the main PipeWire. It captures the physical mic (Settings.micFxSource) and exposes the virtual
// source "monolith_mic" (Monolith Mic), which becomes the default input while the chain runs.
Singleton {
    id: root

    readonly property string nodeName: "monolith_mic"
    readonly property string unit: "monolith-micfx"
    readonly property string plugin: "/usr/lib/ladspa/librnnoise_ladspa.so"
    readonly property string conf: Settings.dir + "/micfx.conf"
    readonly property var bands: [
        { label: "bq_lowshelf", freq: 100, q: 0.707 }, { label: "bq_peaking", freq: 300, q: 1.0 },
        { label: "bq_peaking", freq: 1000, q: 1.0 }, { label: "bq_peaking", freq: 3000, q: 1.0 },
        { label: "bq_highshelf", freq: 8000, q: 0.707 }
    ]
    readonly property var presets: ({
        flat: [0, 0, 0, 0, 0], voice: [-3, -1, 0, 3, 2], warm: [3, 1, 0, -1, -2],
        bright: [-2, 0, 1, 3, 4], deep: [6, 3, -1, 1, -2], basscut: [-9, -3, 0, 0, 0]
    })
    property bool hasRnnoise: false
    readonly property bool noise: Settings.micNoise && hasRnnoise
    readonly property bool wanted: noise || Settings.micEq
    property bool active: false
    property string error: ""

    function gains() {
        const g = Settings.micEqGains
        return bands.map((b, i) => g && g[i] !== undefined ? Number(g[i]) : 0)
    }
    function setGain(i, v) { const g = gains(); g[i] = v; Settings.micEqGains = g; schedule() }
    function setGains(g) { Settings.micEqGains = g.slice(); schedule() }
    function setPreset(id) { if (presets[id]) { Settings.micEqGains = presets[id].slice(); schedule() } }
    function presetOf() {
        const g = gains()
        for (const k in presets) if (presets[k].every((v, i) => v === g[i])) return k
        return "custom"
    }
    // the physical mic to filter: kept when the user picks another input while the chain runs
    function setSource(name) {
        if (!name || name === nodeName) return
        console.log("[micfx] source ->", name)
        Settings.micFxSource = name
        if (wanted) schedule()
    }
    function physicalSource() {
        const cur = Audio.source && Audio.source.name !== nodeName ? Audio.source.name : ""
        if (cur !== "") return cur
        if (Settings.micFxSource !== "") return Settings.micFxSource
        const other = Audio.sources.find(n => n.name !== nodeName)
        return other ? other.name : ""
    }

    function graph() {
        const nodes = [], links = []
        if (noise) nodes.push({ text: '{ type = ladspa name = rnnoise plugin = "' + plugin + '" label = noise_suppressor_mono control = { "VAD Threshold (%)" = '
            + Settings.micNoiseLevel.toFixed(1) + ' "VAD Grace Period (ms)" = 200 "Retroactive VAD Grace (ms)" = 0 } }', inp: "Input", out: "Output" })
        if (Settings.micEq) {
            nodes.push({ text: '{ type = builtin name = hp label = bq_highpass control = { "Freq" = 80.0 "Q" = 0.707 } }', inp: "In", out: "Out" })
            const g = gains()
            bands.forEach((b, i) => nodes.push({ text: '{ type = builtin name = eq' + i + ' label = ' + b.label + ' control = { "Freq" = '
                + b.freq.toFixed(1) + ' "Q" = ' + b.q + ' "Gain" = ' + g[i].toFixed(1) + ' } }', inp: "In", out: "Out" }))
        }
        const name = t => t.match(/name = (\w+)/)[1]
        for (let i = 1; i < nodes.length; i++)
            links.push('{ output = "' + name(nodes[i - 1].text) + ':' + nodes[i - 1].out + '" input = "' + name(nodes[i].text) + ':' + nodes[i].inp + '" }')
        return "nodes = [\n" + nodes.map(n => "          " + n.text).join("\n") + "\n        ]\n        links = [ " + links.join(" ") + " ]"
    }
    function config(src) {
        return "# generated by quickshell (services/MicFx.qml) — changes are overwritten\n"
            + "context.properties = { log.level = 0 }\n"
            + "context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }\n"
            + "context.modules = [\n"
            + "  { name = libpipewire-module-rt args = { nice.level = -11 } flags = [ ifexists nofail ] }\n"
            + "  { name = libpipewire-module-protocol-native }\n"
            + "  { name = libpipewire-module-client-node }\n"
            + "  { name = libpipewire-module-adapter }\n"
            + "  { name = libpipewire-module-filter-chain\n"
            + "    args = {\n"
            + "      node.description = \"Monolith Mic\"\n"
            + "      media.name = \"Monolith Mic\"\n"
            + "      filter.graph = {\n        " + graph() + "\n      }\n"
            + "      audio.channels = 1\n      audio.position = [ MONO ]\n"
            + "      capture.props = { node.name = \"monolith_mic_capture\" node.passive = true stream.dont-remix = true"
            + (src !== "" ? " target.object = " + JSON.stringify(src) : "") + " }\n"
            + "      playback.props = { node.name = \"" + nodeName + "\" media.class = Audio/Source }\n"
            + "    }\n  }\n]\n"
    }

    // (re)start or stop the chain; slider drags are coalesced
    function schedule() { applyTimer.restart() }
    function apply() {
        if (applyProc.running) { applyTimer.restart(); return }
        const src = wanted ? physicalSource() : Settings.micFxSource
        if (wanted && src !== "") Settings.micFxSource = src
        error = ""
        console.log("[micfx] apply: noise=" + noise + " eq=" + Settings.micEq + " level=" + Settings.micNoiseLevel
            + " gains=" + JSON.stringify(gains()) + " source=" + (src || "<default>"))
        if (wanted && src === "") console.warn("[micfx] no physical microphone found; the chain follows the default input")
        applyProc.command = ["sh", "-c", applyScript, "sh", conf, src, wanted ? config(src) : "", wanted ? "1" : "0", nodeName, unit]
        applyProc.running = true
    }
    readonly property string applyScript: '
        conf=$1 src=$2 text=$3 on=$4 node=$5 unit=$6
        was=$(pactl get-default-source 2>/dev/null)
        echo "[micfx] default source before: ${was:-?}"
        systemctl --user stop "$unit.service" 2>/dev/null
        systemctl --user reset-failed "$unit.service" 2>/dev/null
        if [ "$on" != 1 ]; then
            rm -f "$conf"
            if [ "$was" = "$node" ] && [ -n "$src" ]; then pactl set-default-source "$src" && echo "[micfx] default source restored: $src"; fi
            echo "[micfx] stopped"; exit 0
        fi
        printf "%s" "$text" > "$conf" || { echo "[micfx] cannot write $conf" >&2; exit 3; }
        systemd-run --user --unit="$unit" --description="Monolith microphone filter" -q pipewire -c "$conf" || { echo "[micfx] systemd-run failed" >&2; exit 4; }
        i=0
        while [ $i -lt 30 ]; do
            if pactl list short sources 2>/dev/null | grep -q "[[:space:]]$node[[:space:]]"; then
                pactl set-default-source "$node" && echo "[micfx] running; default source: $node"; exit 0
            fi
            i=$((i + 1)); sleep 0.2
        done
        echo "[micfx] $node did not appear; journalctl --user -u $unit:" >&2
        journalctl --user -u "$unit" -n 8 --no-pager -o cat >&2 2>/dev/null
        systemctl --user stop "$unit.service" 2>/dev/null
        exit 5'

    property bool booting: false
    function check() { checkProc.running = true }
    // the plugin check comes first: `wanted` depends on it
    function init() {
        booting = true
        if (Settings.loaded) check(); else Settings.loadedOnce.connect(check)
    }

    Timer { id: applyTimer; interval: 700; onTriggered: root.apply() }
    Process {
        id: applyProc
        stdout: SplitParser { onRead: l => console.log(l) }
        stderr: SplitParser { onRead: l => { console.warn(l); root.error = l } }
        onExited: code => {
            root.active = code === 0 && root.wanted
            if (code !== 0) console.warn("[micfx] apply failed with exit code", code)
        }
    }
    Process {
        id: checkProc
        command: ["test", "-f", root.plugin]
        onExited: code => {
            root.hasRnnoise = code === 0
            console.log("[micfx] rnnoise plugin " + (root.hasRnnoise ? "found" : "missing") + ": " + root.plugin)
            if (root.booting) { root.booting = false; statusProc.running = true }
        }
    }
    // at login: start the chain if it is enabled and not already running (it outlives shell reloads)
    Process {
        id: statusProc
        command: ["systemctl", "--user", "is-active", "-q", root.unit + ".service"]
        onExited: code => {
            root.active = code === 0
            console.log("[micfx] startup: unit " + (code === 0 ? "active" : "inactive") + ", wanted=" + root.wanted)
            if (root.wanted !== root.active) root.schedule()
        }
    }
}
