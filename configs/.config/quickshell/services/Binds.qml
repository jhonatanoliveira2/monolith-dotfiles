pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../core"

// Hyprland key binds edited in Settings > Input. The defaults are read from hypr/modules/bind-defaults.lua
// (one `["id"] = "COMBO",` per line); changes go to hypr/generated/binds.lua (same format, only the binds
// that differ), which keybindings.lua / media-keys.lua apply on the Hyprland reload that follows.
// A combo is "MOD + MOD + key"; "" leaves the bind off.
Singleton {
    id: root
    readonly property string hyprDir: Quickshell.env("HOME") + "/.config/hypr"
    property var defaults: ({})          // id -> combo
    property var overrides: ({})         // id -> combo (only the changed ones)
    readonly property var modNames: ["SUPER", "SHIFT", "CTRL", "ALT"]
    readonly property bool available: Object.keys(defaults).length > 0

    // normalized combo -> ids using it (conflicts)
    readonly property var used: {
        const out = {}
        for (const id in defaults) {
            const n = norm(combo(id))
            if (n !== "") (out[n] = out[n] || []).push(id)
        }
        return out
    }

    function combo(id) { return overrides[id] !== undefined ? overrides[id] : (defaults[id] || "") }
    function changed(id) { return overrides[id] !== undefined }
    function split(c) {
        const parts = String(c || "").split("+").map(x => x.trim()).filter(x => x.length)
        const mods = []
        let key = ""
        for (const p of parts) {
            const m = ({ CONTROL: "CTRL", WIN: "SUPER", MOD4: "SUPER" })[p.toUpperCase()] || p.toUpperCase()
            if (modNames.indexOf(m) >= 0) { if (mods.indexOf(m) < 0) mods.push(m) } else key = p
        }
        return { mods, key }
    }
    function join(mods, key) {
        if (!key) return ""
        return modNames.filter(m => mods.indexOf(m) >= 0).concat([key]).join(" + ")
    }
    function norm(c) { const s = split(c); return join(s.mods, s.key).toUpperCase() }
    // key names: letters / digits / keysyms (comma, XF86AudioMute), code:NN, mouse:NNN, mouse_up
    function validKey(k) { return k === "" || /^[A-Za-z0-9_:]+$/.test(k) }
    function conflicts(id) { return (used[norm(combo(id))] || []).filter(x => x !== id) }

    function set(id, c) {
        const o = Object.assign({}, overrides)
        if (norm(c) === norm(defaults[id])) delete o[id]
        else o[id] = c
        overrides = o
        writeSoon.restart()
    }
    function reset(id) { set(id, defaults[id] || "") }
    function resetAll() { overrides = ({}); writeSoon.restart() }

    function parse(text) {
        const out = {}
        const re = /^\s*\["([\w.]+)"\]\s*=\s*"([^"]*)"/gm
        let m
        while ((m = re.exec(text)) !== null) out[m[1]] = m[2]
        return out
    }

    FileView {
        path: root.hyprDir + "/modules/bind-defaults.lua"
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: root.defaults = root.parse(text())
    }
    FileView {
        id: genFile
        path: root.hyprDir + "/generated/binds.lua"
        watchChanges: true
        blockWrites: true
        printErrors: false
        onFileChanged: if (!writeSoon.running) reload()
        onLoaded: root.overrides = root.parse(text())
        onLoadFailed: root.overrides = ({})
    }

    // several edits in a row become one write + one Hyprland reload
    Timer { id: writeSoon; interval: 700; onTriggered: mkdirProc.running = true }
    Process {
        id: mkdirProc
        command: ["mkdir", "-p", root.hyprDir + "/generated"]
        onExited: code => {
            if (code !== 0) return
            const ids = Object.keys(root.overrides).sort()
            genFile.setText("-- Generated by the MONOLITH Settings app (Quickshell): Settings > Input > key binds.\n"
                + "-- Only the binds changed from modules/bind-defaults.lua. Delete this file to go back to the defaults.\n"
                + "return {\n" + ids.map(id => "    [\"" + id + "\"] = \"" + root.overrides[id] + "\",\n").join("") + "}\n")
            Sys.reloadHyprland()
        }
    }

    // ── what the Settings page lists: categories in order, then the binds of each ──
    function pair(pt, en) { return [pt, en] }
    readonly property var categories: [
        { id: "apps", label: pair("Atalhos — aplicativos", "Binds — applications") },
        { id: "shell", label: pair("Atalhos — shell", "Binds — shell") },
        { id: "capture", label: pair("Atalhos — captura", "Binds — capture") },
        { id: "session", label: pair("Atalhos — sessão", "Binds — session") },
        { id: "windows", label: pair("Atalhos — janelas", "Binds — windows") },
        { id: "focus", label: pair("Atalhos — foco, mover e redimensionar", "Binds — focus, move and resize") },
        { id: "workspaces", label: pair("Atalhos — áreas de trabalho", "Binds — workspaces") },
        { id: "zoom", label: pair("Atalhos — zoom do cursor", "Binds — cursor zoom") },
        { id: "hardware", label: pair("Atalhos — teclas de mídia e hardware", "Binds — media and hardware keys") }
    ]
    readonly property var labels: {
        const m = {
            "app.terminal": pair("Terminal", "Terminal"), "app.files": pair("Gerenciador de arquivos", "File manager"),
            "app.ide": pair("Editor de código", "Code editor"), "app.browser": pair("Navegador", "Browser"),
            "shell.launcher": pair("Lançador de apps", "App launcher"), "shell.wallpaper": pair("Seletor de wallpapers", "Wallpaper picker"),
            "shell.notifications": pair("Central de notificações", "Notification center"), "shell.media": pair("Menu de mídia", "Media menu"),
            "shell.settings": pair("Configurações", "Settings"), "shell.session": pair("Menu rápido / sessão", "Quick menu / session"),
            "capture.screen": pair("Capturar o monitor", "Capture the monitor"), "capture.area": pair("Capturar uma área", "Capture an area"),
            "capture.record": pair("Gravar a tela (liga / desliga)", "Record the screen (on / off)"),
            "session.lock": pair("Bloquear a tela", "Lock the screen"), "session.exit": pair("Encerrar a sessão", "End the session"),
            "win.close": pair("Fechar janela", "Close window"), "win.float": pair("Flutuar e centralizar", "Float and center"),
            "win.floatKeep": pair("Flutuar (sem mover)", "Float (in place)"), "win.fullscreen": pair("Tela cheia", "Fullscreen"),
            "win.pin": pair("Fixar em todas as áreas", "Pin to all workspaces"), "win.split": pair("Alternar divisão", "Toggle split"),
            "win.group": pair("Agrupar janelas", "Group windows"), "win.drag": pair("Mover com o mouse", "Move with the mouse"),
            "win.resizeMouse": pair("Redimensionar com o mouse", "Resize with the mouse"),
            "focus.last": pair("Janela anterior / urgente", "Previous / urgent window"),
            "ws.prev": pair("Área ocupada anterior", "Previous occupied workspace"), "ws.next": pair("Próxima área ocupada", "Next occupied workspace"),
            "ws.special": pair("Área especial (mostrar / ocultar)", "Special workspace (show / hide)"),
            "ws.toSpecial": pair("Mover janela para a área especial", "Move window to the special workspace"),
            "ws.toMonitor": pair("Mover janela para o próximo monitor", "Move window to the next monitor"),
            "zoom.out": pair("Diminuir zoom (roda)", "Zoom out (wheel)"), "zoom.in": pair("Aumentar zoom (roda)", "Zoom in (wheel)"),
            "zoom.outPad": pair("Diminuir zoom (teclado numérico)", "Zoom out (keypad)"), "zoom.inPad": pair("Aumentar zoom (teclado numérico)", "Zoom in (keypad)"),
            "hw.volUp": pair("Aumentar volume", "Volume up"), "hw.volDown": pair("Diminuir volume", "Volume down"), "hw.mute": pair("Silenciar", "Mute"),
            "hw.micMute": pair("Silenciar microfone", "Mute microphone"), "hw.brightUp": pair("Aumentar brilho", "Brightness up"),
            "hw.brightDown": pair("Diminuir brilho", "Brightness down"), "hw.touchpad": pair("Touchpad liga / desliga", "Touchpad on / off"),
            "hw.kbdUp": pair("Luz do teclado +", "Keyboard light +"), "hw.kbdDown": pair("Luz do teclado −", "Keyboard light −"),
            "hw.kbdLight": pair("Luz do teclado (ciclo)", "Keyboard light (cycle)"), "hw.next": pair("Próxima faixa", "Next track"),
            "hw.prev": pair("Faixa anterior", "Previous track"), "hw.play": pair("Tocar / pausar", "Play / pause"), "hw.pause": pair("Pausar", "Pause")
        }
        const dirs = { left: pair("esquerda", "left"), right: pair("direita", "right"), up: pair("cima", "up"), down: pair("baixo", "down") }
        const verbs = { focus: pair("Focar", "Focus"), move: pair("Mover janela", "Move window"), swap: pair("Trocar com a janela", "Swap with window"), resize: pair("Redimensionar", "Resize") }
        for (const v in verbs) for (const d in dirs) m[v + "." + d] = pair(verbs[v][0] + " — " + dirs[d][0], verbs[v][1] + " — " + dirs[d][1])
        for (let i = 1; i <= 10; i++) {
            m["ws.go" + i] = pair("Ir para a área " + i, "Go to workspace " + i)
            m["ws.move" + i] = pair("Mover janela para a área " + i, "Move window to workspace " + i)
        }
        return m
    }
    function catOf(id) {
        const p = id.split(".")[0]
        return ({ app: "apps", shell: "shell", capture: "capture", session: "session", win: "windows", focus: "focus", move: "focus",
                  swap: "focus", resize: "focus", ws: "workspaces", zoom: "zoom", hw: "hardware" })[p] || "apps"
    }
    function label(id) { return labels[id] ? labels[id][Config.language === "en" ? 1 : 0] : id }
    // ids of a category, in the order of bind-defaults.lua
    function inCategory(cat) { return Object.keys(defaults).filter(id => catOf(id) === cat) }
}
