/* audio-menu.rasi — monocromático, preto levemente translúcido, sem decoração */
* {
    font:     "JetBrainsMono Nerd Font Bold 11";
    bg:       #111111d9;
    fg:       #cccccc;
    fg-sel:   #ffffff;
    sel:      #ffffff1f;
    line:     #c8c8c840;

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         northeast;
    anchor:           northeast;
    x-offset:         -6px;
    y-offset:         34px;
    width:            360px;
    background-color: @bg;
    border:           1px;
    border-color:     @line;
    border-radius:    1px;
    padding:          4px;
}

mainbox {
    children: [ "listview" ];
}

listview {
    lines:        8;
    columns:      1;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       6px 10px;
    border-radius: 1px;
}

element selected.normal {
    background-color: @sel;
    text-color:       @fg-sel;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        none;
    vertical-align:   0.5;
}

message {
    padding: 6px 10px;
}
textbox {
    text-color: @fg-sel;
}
