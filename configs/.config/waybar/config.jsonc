{
    "modules-left": [
        "custom/power",
        "hyprland/workspaces",
        "group/player"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/sysmon",
        "custom/network",
        "bluetooth",
        "battery", // @laptop-only
        "custom/powerprofile", // @laptop-only
        "group/brightness", // @laptop-only
        "group/volume" // @laptop-swap (no desktop vira pulseaudio)
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "●",
        "format-icons": {
            "active": "●"
        },
        "cursor": true
    },
    "bluetooth": {
        "format": "{icon}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip": true,
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "blueman-manager & sleep 1 && pkill blueman-tray"
    },
    "custom/network": {
        "exec": "~/.config/waybar/scripts/network-status.sh",
        "return-type": "json",
        "format": "{}",
        "restart-interval": 5,
        "tooltip": true,
        "on-click": "nm-connection-editor"
    },
    "custom/sysmon": {
        "exec": "~/.config/waybar/scripts/sysmon.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 5,
        "tooltip": true
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon}{capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon}{capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}\n{power:.1f} W",
        "interval": 30,
        "cursor": false
    },
    "custom/powerprofile": {
        "exec": "~/.config/waybar/scripts/power-profile.sh status",
        "return-type": "json",
        "format": "{}",
        "interval": 10,
        "signal": 11,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/power-profile.sh cycle"
    },
    "backlight": {
        "device": "intel_backlight",
        "scroll-step": 5,
        "min-brightness": 1,
        "format": "{icon} {percent}%",
        "format-icons": [
            "",
            ""
        ]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "scroll-step": 5,
        "format-muted": " {volume}%",
        "format-bluetooth": "󰂯{volume}%",
        "format-bluetooth-muted": " {volume}%",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                " "
            ]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "~/.config/waybar/scripts/audio-menu.sh"
    },
    "group/volume": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "group/brightness": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            "backlight",
            "backlight/slider"
        ]
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "backlight/slider": {
        "device": "intel_backlight",
        "min": 5,
        "max": 100,
        "orientation": "horizontal"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6,
        "cursor": true
    },
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    },
    "group/player": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 200,
            "transition-left-to-right": true,
            "children-class": "drawer-child"
        },
        "modules": [
            "custom/player",
            "custom/player-prev",
            "custom/player-toggle",
            "custom/player-next",
            "custom/player-progress"
        ]
    },
    "custom/player-progress": {
        "exec": "~/.config/waybar/scripts/player.sh progress",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "tooltip": false
    },
    "custom/player-prev": {
        "exec": "~/.config/waybar/scripts/player.sh button prev",
        "return-type": "json",
        "format": "{}",
        "interval": "once",
        "signal": 10,
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/player.sh ctl prev"
    },
    "custom/player-toggle": {
        "exec": "~/.config/waybar/scripts/player.sh button toggle",
        "return-type": "json",
        "format": "{}",
        "interval": "once",
        "signal": 10,
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/player.sh ctl toggle"
    },
    "custom/player-next": {
        "exec": "~/.config/waybar/scripts/player.sh button next",
        "return-type": "json",
        "format": "{}",
        "interval": "once",
        "signal": 10,
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/player.sh ctl next"
    },
    "custom/player": {
        "exec": "~/.config/waybar/scripts/player.sh text",
        "return-type": "json",
        "format": "{}",
        "restart-interval": 5,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/player.sh ctl toggle",
        "on-scroll-up": "~/.config/waybar/scripts/player.sh ctl seek+",
        "on-scroll-down": "~/.config/waybar/scripts/player.sh ctl seek-"
    },
    "clock": {
        "format": "{:%H:%M ~ %d/%m/%y}",
        "tooltip-format": "<span size='11000' font-family='Awaita Mono' line_height='1'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#777777'>{}</span>",
                "weekdays": "<span color='#999999'>{}</span>",
                "days": "<span color='#555555'>{}</span>",
                "today": "<span color='#FFFFFF'>{}</span>"
            }
        },
        "on-click": "swaync-client -t -sw"
    }
}
