#!/usr/bin/env bash
# wallpaper-menu — MONOLITH wallpaper picker
#   static wallpapers : awww        live wallpapers : mpvpaper        menu : rofi (with previews)
#
# Usage:  wallpaper-menu              open the rofi menu (run it again to close it)
#         wallpaper-menu --restore    re-apply the last choice (put it in your autostart)
#         wallpaper-menu --clear-cache   delete the generated previews
#         wallpaper-menu --clear-dotmatrix   delete the dot-matrix renderings (Nothing theme)
#         wallpaper-menu --list <image|video>              path<TAB>preview per line (used by the shell picker)
#         wallpaper-menu --set <static|live> <file> [ALL|out1,out2]   apply without a menu (used by the shell)
# The Quickshell picker (Settings > Wallpapers) passes its options through the WALLPAPER_* variables below.
#
# Dependencies: rofi hyprctl jq awww mpvpaper  |  previews: ffmpeg  |  notifications: libnotify (optional)
# Theme: ~/.config/hypr/rofi/wallpaper-menu.rasi (colours and border are variables at its top)
# Nothing theme (~/.config/monolith/nothing.json, written by the NixOS / Home Manager module): with its
# wallpaper style "dotmatrix", a still wallpaper is shown as an LED matrix rendered by monolith-dotmatrix for
# each monitor at its native size: the build-time rendering when it matches, else one cached in
# ~/.cache/monolith/dotmatrix. The original file is never modified, and it is what the state file records.
set -uo pipefail
QUIET=0

# ───────────────────────────── configuration ─────────────────────────────
STATIC_DIR="${WALLPAPER_STATIC_DIR:-$HOME/Pictures/Wallpapers}"
STATIC_DIR="${STATIC_DIR/#\~/$HOME}"

# Folders scanned for live wallpapers (not recursive) ...
LIVE_DIRS=(
    "${WALLPAPER_LIVE_DIR:-$HOME/Videos/wallpaper-live}"
    "$HOME/dotfiles/home/pictures/wallpaper-live"
)
# ... plus individual files (no need to scan their whole folder, e.g. ~/Downloads).
LIVE_FILES=(
    "$HOME/Downloads/bliss-windows-xp.mp4"
)

THEME="${WALLPAPER_ROFI_THEME:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/rofi/wallpaper-menu.rasi}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-menu"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-menu/last"
DM_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/monolith/dotmatrix"
NOTHING_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/monolith/nothing.json"
SHELL_SETTINGS="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell-monolith/settings.json"

THUMB_W=480 THUMB_H=270                 # preview size (16:9)
GRID_COLUMNS=4 GRID_LINES=3             # wallpaper grid

AWWW_ARGS=(--transition-type "${WALLPAPER_TRANSITION:-fade}" --transition-duration "${WALLPAPER_TRANSITION_DURATION:-0.7}")
MPVPAPER_FLAGS=()
[[ ${WALLPAPER_LIVE_PAUSE:-1} == 1 ]] && MPVPAPER_FLAGS=(-p)    # -p: pause playback while the wallpaper is fully covered
MPV_OPTIONS="loop-file=inf hwdec=auto-safe panscan=1.0"
[[ ${WALLPAPER_LIVE_AUDIO:-0} == 1 ]] || MPV_OPTIONS="no-audio $MPV_OPTIONS"

IMG_EXT=(jpg jpeg png webp gif bmp)
VID_EXT=(mp4 mkv webm mov avi gif)

# ─────────────────────────────── helpers ─────────────────────────────────
need() { command -v "$1" >/dev/null 2>&1; }

notify() {
    printf '%s\n' "$1" >&2
    need notify-send && notify-send -a wallpaper-menu -u low "Wallpaper" "$1"
    return 0
}

die() {
    notify "$1"
    exit 1
}

join_by_comma() { local IFS=,; printf '%s' "$*"; }

# collect_files <image|video> <dir|file>...   -> NUL-separated, sorted, de-duplicated
collect_files() {
    local kind=$1 item ext
    shift
    local -a exts names=('(')
    if [[ $kind == image ]]; then exts=("${IMG_EXT[@]}"); else exts=("${VID_EXT[@]}"); fi
    for ext in "${exts[@]}"; do names+=(-iname "*.$ext" -o); done
    unset 'names[-1]'
    names+=(')')
    for item in "$@"; do
        if [[ -d $item ]]; then
            find -L "$item" -maxdepth 1 -type f "${names[@]}" -print0
        elif [[ -f $item ]]; then
            printf '%s\0' "$item"
        fi
    done | sort -zu
}

# ───────────────────────────── previews (cache) ──────────────────────────
thumb_path() {
    local key
    key=$(printf '%s|%s' "$1" "$(stat -c '%Y-%s' -- "$1" 2>/dev/null)" | sha1sum | cut -d' ' -f1)
    printf '%s/thumbs/%s.jpg' "$CACHE_DIR" "$key"
}

# make_thumb <file>: create the preview if it does not exist yet (safe to run in parallel).
make_thumb() {
    local f=$1 out tmp seek=()
    out=$(thumb_path "$f")
    [[ -s $out ]] && return 0
    mkdir -p "${out%/*}"
    tmp="${out%.jpg}.$$.tmp.jpg"
    case ${f,,} in *.gif) ;; *.jpg | *.jpeg | *.png | *.webp | *.bmp) ;; *) seek=(-ss 1) ;; esac
    local vf="scale=${THUMB_W}:${THUMB_H}:force_original_aspect_ratio=increase,crop=${THUMB_W}:${THUMB_H}"
    ffmpeg -loglevel error -y "${seek[@]}" -i "$f" -vf "$vf" -frames:v 1 -q:v 4 "$tmp" 2>/dev/null \
        || ffmpeg -loglevel error -y -i "$f" -vf "$vf" -frames:v 1 -q:v 4 "$tmp" 2>/dev/null
    if [[ -s $tmp ]]; then mv -f "$tmp" "$out"; else rm -f "$tmp"; return 1; fi
}

# Generate every missing preview, in parallel.
build_thumbs() {
    need ffmpeg || return 0
    local -a missing=()
    local f
    for f in "$@"; do [[ -s $(thumb_path "$f") ]] || missing+=("$f"); done
    (( ${#missing[@]} )) || return 0
    (( ${#missing[@]} > 6 && ! QUIET )) && notify "Generating ${#missing[@]} previews (first run only)…"
    export -f make_thumb thumb_path
    export CACHE_DIR THUMB_W THUMB_H
    printf '%s\0' "${missing[@]}" | xargs -0 -r -P "$(nproc 2>/dev/null || echo 4)" -I{} bash -c 'make_thumb "$1"' _ {}
    # forget previews that were not used for 90 days
    find "$CACHE_DIR/thumbs" -type f -atime +90 -delete 2>/dev/null
}

# ─────────────────────────────── rofi menus ──────────────────────────────
# rofi_menu <prompt> [rofi args...]   (rows on stdin)  -> prints the selected row index
rofi_menu() {
    local prompt=$1
    shift
    local -a theme=()
    [[ -f $THEME ]] && theme=(-theme "$THEME")
    rofi -dmenu -i -no-custom -format i -p "$prompt" "${theme[@]}" "$@"
}

GRID_THEME="window { width: 1100px; }
listview { columns: ${GRID_COLUMNS}; lines: ${GRID_LINES}; fixed-columns: true; fixed-height: true; flow: horizontal; spacing: 12px; }
element { orientation: vertical; padding: 10px; spacing: 8px; }
element-icon { size: 12em; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; }"

MONITORS=() MONITOR_LABELS=()
declare -A MONITOR_SIZE=()              # native pixels as shown (rotated outputs swapped)
load_monitors() {
    local name label size
    while IFS=$'\t' read -r name label size; do
        MONITORS+=("$name")
        MONITOR_LABELS+=("$name  ·  $label")
        MONITOR_SIZE[$name]=$size
    done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[] | [.name, "\(.width)x\(.height)@\(.refreshRate | round)",
        (if (.transform % 2) == 1 then "\(.height)x\(.width)" else "\(.width)x\(.height)" end)] | @tsv')
    (( ${#MONITORS[@]} )) || die "No active Hyprland monitors found."
}

TARGETS=() ALL_TARGETS=1
choose_monitor() {
    local idx
    TARGETS=() ALL_TARGETS=1
    if (( ${#MONITORS[@]} == 1 )); then
        TARGETS=("${MONITORS[0]}")
        return 0
    fi
    idx=$(printf '%s\n' "All monitors" "${MONITOR_LABELS[@]}" | rofi_menu "Monitor") || return 1
    [[ $idx =~ ^[0-9]+$ ]] || return 1
    if (( idx == 0 )); then
        TARGETS=("${MONITORS[@]}")
    else
        TARGETS=("${MONITORS[idx - 1]}")
        ALL_TARGETS=0
    fi
}

# choose_file <prompt> <image|video> <dir|file>...   -> prints the chosen path
choose_file() {
    local prompt=$1 kind=$2 idx f label thumb
    shift 2
    local -a files=()
    mapfile -d '' -t files < <(collect_files "$kind" "$@")
    (( ${#files[@]} )) || { notify "No compatible files found."; return 1; }
    build_thumbs "${files[@]}"
    idx=$(
        for f in "${files[@]}"; do
            label=${f##*/}
            label=${label%.*}
            thumb=$(thumb_path "$f")
            if [[ -s $thumb ]]; then
                printf '%s\0icon\x1f%s\n' "$label" "$thumb"
            else
                printf '%s\n' "$label"
            fi
        done | rofi_menu "$prompt" -show-icons -theme-str "$GRID_THEME"
    ) || return 1
    [[ $idx =~ ^[0-9]+$ ]] || return 1
    printf '%s' "${files[idx]}"
}

# ───────────────────────────── applying wallpapers ───────────────────────
# ─────────────────────── Nothing theme: dot-matrix wallpapers ──────────────────
# dm_load: 0 when still wallpapers are to be shown as LED matrices; sets DM_ARGS / DM_KEY / DM_BUILT*.
# The look comes from WALLPAPER_NOTHING (the shell passes it, current to the second) or else from
# nothing.json's defaults plus the shell's saved overrides.
DM_ARGS=() DM_KEY="" DM_BUILT_DIR="" DM_BUILT_KEY=""
dm_load() {
    [[ -r $NOTHING_JSON ]] && need jq && need monolith-dotmatrix || return 1
    local look
    if [[ -n ${WALLPAPER_NOTHING:-} ]]; then look=$WALLPAPER_NOTHING
    else
        look=$(jq -c --slurpfile s <(jq -c '.nothing // {}' "$SHELL_SETTINGS" 2>/dev/null || echo '{}') \
            '.defaults * ($s[0] // {})' "$NOTHING_JSON" 2>/dev/null) || return 1
    fi
    local fields
    fields=$(jq -r 'select(.enabled == true and .wallpaperStyle == "dotmatrix")
        | [.ledSize // 6, .ledSpacing // 3, .ledShape // "circle", .dither // "none", .levels // 2,
           (.invert // false), (.monochrome // true), .lit // "f2f2f2", .off // "141414", .background // "000000",
           ((.contrast // 100) / 100), ((.brightness // 100) / 100)] | @tsv' <<<"$look" 2>/dev/null)
    [[ -n $fields ]] || return 1
    local size spacing shape dither levels invert mono lit off bg contrast brightness
    IFS=$'\t' read -r size spacing shape dither levels invert mono lit off bg contrast brightness <<<"$fields"
    DM_ARGS=(--size "$size" --spacing "$spacing" --shape "$shape" --dither "$dither" --levels "$levels"
             --lit "${lit#\#}" --off "${off#\#}" --background "${bg#\#}" --contrast "$contrast" --brightness "$brightness")
    [[ $invert == true ]] && DM_ARGS+=(--invert)
    [[ $mono == true ]] || DM_ARGS+=(--color)
    DM_KEY=$(monolith-dotmatrix --key "${DM_ARGS[@]}") || return 1
    IFS=$'\t' read -r DM_BUILT_DIR DM_BUILT_KEY < <(jq -r '[.wallpapers.dir // "", .wallpapers.key // ""] | @tsv' "$NOTHING_JSON")
    return 0
}

# dm_image <file> <monitor>: prints the picture to show on that monitor (the original when it cannot be
# converted: animated, unreadable, unknown size)
dm_image() {
    local file=$1 mon=$2 size=${MONITOR_SIZE[$2]:-} sum name out
    [[ -n $size ]] || { printf '%s\n' "$file"; return; }
    sum=$(sha256sum <"$file" | cut -d' ' -f1)
    # rendered at build time: same picture, same look, this monitor at this size
    if [[ -n $DM_BUILT_DIR && $DM_BUILT_KEY == "$DM_KEY" && -r $DM_BUILT_DIR/index.tsv ]]; then
        name=$(awk -F'\t' -v s="$sum" '$1 == s { print $2; exit }' "$DM_BUILT_DIR/index.tsv")
        out=$DM_BUILT_DIR/$name/$mon.png
        if [[ -n $name && -f $out ]] && [[ $(magick identify -format '%wx%h' "$out" 2>/dev/null) == "$size" ]]; then
            printf '%s\n' "$out"; return
        fi
    fi
    out=$DM_CACHE/$(printf '%s|%s|%s' "$sum" "$size" "$DM_KEY" | sha256sum | cut -c1-32).png
    if [[ ! -s $out ]]; then
        mkdir -p "$DM_CACHE"
        if ! monolith-dotmatrix "$file" -o "$out" --resolution "$size" "${DM_ARGS[@]}" 2>"$DM_CACHE/last-error"; then
            rm -f "$out"
            notify "Dot matrix: $(tail -n1 "$DM_CACHE/last-error" 2>/dev/null) — showing the original."
            printf '%s\n' "$file"; return
        fi
        touch "$out"
    fi
    printf '%s\n' "$out"
}

save_state() { # save_state <static|live> <outputs|ALL> [file]
    mkdir -p "${STATE_FILE%/*}"
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >"$STATE_FILE"
}

# Stop live wallpapers on the given outputs (all of them when ALL_TARGETS=1).
stop_live() {
    local m
    if (( ALL_TARGETS )); then
        pkill -x mpvpaper 2>/dev/null
    else
        for m in "${TARGETS[@]}"; do pkill -f -- "^mpvpaper .* ${m} /" 2>/dev/null; done
    fi
    return 0
}

ensure_awww() {
    awww query >/dev/null 2>&1 && return 0
    setsid -f awww-daemon >/dev/null 2>&1
    local _
    for _ in {1..30}; do
        awww query >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    return 1
}

start_live() { # start_live <file> <outputs...>
    local file=$1 m
    shift
    for m in "$@"; do
        setsid -f mpvpaper "${MPVPAPER_FLAGS[@]}" -o "$MPV_OPTIONS" "$m" "$file" >/dev/null 2>&1
    done
}

apply_static() {
    need awww || die "Missing dependency: awww"
    local file
    file=$(choose_file "Static wallpaper" image "$STATIC_DIR") || return 0
    choose_monitor || return 0
    set_static "$file"
}
set_static() { # set_static <file>   (TARGETS / ALL_TARGETS already chosen)
    local file=$1
    need awww || die "Missing dependency: awww"
    stop_live
    ensure_awww || die "Could not start awww-daemon."
    if dm_load; then        # Nothing theme: one LED matrix per monitor, at its own resolution
        local m
        for m in "${TARGETS[@]}"; do
            awww img --outputs "$m" "${AWWW_ARGS[@]}" "$(dm_image "$file" "$m")" || die "awww failed to set the wallpaper."
        done
    else
        awww img --outputs "$(join_by_comma "${TARGETS[@]}")" "${AWWW_ARGS[@]}" "$file" || die "awww failed to set the wallpaper."
    fi
    save_state static "$( ((ALL_TARGETS)) && echo ALL || join_by_comma "${TARGETS[@]}")" "$file"
}

apply_live() {
    need mpvpaper || die "Missing dependency: mpvpaper"
    local file
    file=$(choose_file "Live wallpaper" video "${LIVE_DIRS[@]}" "${LIVE_FILES[@]}") || return 0
    choose_monitor || return 0
    set_live "$file"
}
set_live() { # set_live <file>   (TARGETS / ALL_TARGETS already chosen)
    local file=$1
    need mpvpaper || die "Missing dependency: mpvpaper"
    stop_live
    # All monitors: stop awww so its image never covers the video. One monitor: keep awww for the others.
    if (( ALL_TARGETS )) && need awww; then awww kill >/dev/null 2>&1; fi
    start_live "$file" "${TARGETS[@]}"
    save_state live "$( ((ALL_TARGETS)) && echo ALL || join_by_comma "${TARGETS[@]}")" "$file"
}

restore_last() {
    [[ -r $STATE_FILE ]] || exit 0
    local kind outputs file
    IFS=$'\t' read -r kind outputs file <"$STATE_FILE"
    load_monitors
    case $kind in
        static)
            # Nothing theme: render again (from the cache) so a changed look or a new monitor is right
            if [[ -f $file ]] && dm_load; then
                if [[ $outputs == ALL ]]; then TARGETS=("${MONITORS[@]}") ALL_TARGETS=1
                else IFS=, read -r -a TARGETS <<<"$outputs"; ALL_TARGETS=0; fi
                QUIET=1 set_static "$file"
            else
                need awww && ensure_awww && awww restore >/dev/null 2>&1
            fi
            ;;
        live)
            need mpvpaper && [[ -f $file ]] || exit 0
            local -a outs
            if [[ $outputs == ALL ]]; then outs=("${MONITORS[@]}"); need awww && awww kill >/dev/null 2>&1
            else IFS=, read -r -a outs <<<"$outputs"; fi
            pkill -x mpvpaper 2>/dev/null
            start_live "$file" "${outs[@]}"
            ;;
    esac
    exit 0
}

# ─────────────────────────────────── main ────────────────────────────────
case ${1:-} in
    -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --clear-cache) rm -rf -- "$CACHE_DIR/thumbs"; echo "previews removed"; exit 0 ;;
    --clear-dotmatrix) rm -rf -- "$DM_CACHE"; echo "dot-matrix renderings removed"; exit 0 ;;
    --restore) need hyprctl && need jq || exit 1; restore_last ;;
    --list)
        QUIET=1
        if [[ ${2:-} == video ]]; then mapfile -d '' -t files < <(collect_files video "${LIVE_DIRS[@]}" "${LIVE_FILES[@]}")
        else mapfile -d '' -t files < <(collect_files image "$STATIC_DIR"); fi
        (( ${#files[@]} )) && build_thumbs "${files[@]}"
        for f in "${files[@]}"; do
            t=$(thumb_path "$f"); [[ -s $t ]] || t=""
            printf '%s\t%s\n' "$f" "$t"
        done
        exit 0 ;;
    --set)
        kind=${2:-} file=${3:-} outs=${4:-ALL}
        [[ -f $file ]] || die "File not found: $file"
        need hyprctl && need jq || die "Missing dependency: hyprctl / jq"
        load_monitors
        if [[ $outs == ALL ]]; then TARGETS=("${MONITORS[@]}") ALL_TARGETS=1
        else IFS=, read -r -a TARGETS <<<"$outs"; ALL_TARGETS=0; fi
        case $kind in static) set_static "$file" ;; live) set_live "$file" ;; *) die "Unknown kind: $kind" ;; esac
        exit 0 ;;
esac

# second press closes the menu
if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    exit 0
fi

for cmd in rofi hyprctl jq; do
    need "$cmd" || die "Missing dependency: $cmd"
done
need ffmpeg || notify "ffmpeg not found: previews are disabled."
[[ -f $THEME ]] || printf 'Rofi theme not found (%s): using the default theme.\n' "$THEME" >&2

load_monitors

choice=$(printf '%s\n' "Static wallpaper" "Live wallpaper" | rofi_menu "Wallpaper") || exit 0
case $choice in
    0) apply_static ;;
    1) apply_live ;;
esac
