# Home Manager side of the Nothing theme (options: nothing-options.nix, programs.monolith.nothingTheme; on NixOS
# they come from monolith.nothingTheme). Writes the design tokens and the defaults for the shell to
# ~/.config/monolith/nothing.json (read by core/Nothing.qml and by wallpaper-menu), installs the fonts and
# the dot-matrix renderer, and renders the wallpapers of `wallpaper.outputs` at build time.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.monolith.nothingTheme;
  # the store file, or the checkout's in development mode (dev.nix)
  devLink =
    module: path: store:
    config.programs.monolith.dev.link { inherit module path store; };
  mpkgs = import ../pkgs { inherit pkgs; };
  tokens = import ../nothing/tokens.nix;
  w = cfg.wallpaper;
  bare = c: lib.toLower (lib.removePrefix "#" c);
  colors = lib.mapAttrs (_: bare) w.colors;
  # the same string as `monolith-dotmatrix --key` (nix/nothing/dotmatrix.py): equal keys = identical output
  key = lib.concatStringsSep "-" [
    "v5" # LOOK in dotmatrix.py
    (toString cfg.led.size)
    (toString cfg.led.spacing)
    cfg.led.shape
    w.dither
    (toString w.levels)
    (if w.invert then "inv" else "pos")
    (if cfg.monochrome then "mono" else "color")
    colors.lit
    colors.off
    colors.background
    "c${toString w.contrast}"
    "b${toString w.brightness}"
  ];
  # 115 -> "1.15": the renderer takes factors, the options are percentages
  factor = p: "${toString (p / 100)}.${lib.fixedWidthNumber 2 (lib.mod p 100)}";
  args = [
    "--size"
    (toString cfg.led.size)
    "--spacing"
    (toString cfg.led.spacing)
    "--shape"
    cfg.led.shape
    "--dither"
    w.dither
    "--levels"
    (toString w.levels)
    "--lit"
    colors.lit
    "--off"
    colors.off
    "--background"
    colors.background
    "--contrast"
    (factor w.contrast)
    "--brightness"
    (factor w.brightness)
  ]
  ++ lib.optional w.invert "--invert"
  ++ lib.optional (!cfg.monochrome) "--color";
  rendered = w.style == "dotmatrix" && w.outputs != { };
  wallpapers = pkgs.callPackage ../pkgs/nothing-wallpapers.nix {
    inherit (mpkgs) dotmatrix;
    inherit args key;
    inherit (w) dirs outputs;
  };
in
{
  options.programs.monolith.nothingTheme = import ./nothing-options.nix { inherit lib; };

  config = lib.mkIf (config.programs.monolith.enable && cfg.enable) {
    home.packages = [
      mpkgs.dotmatrix
      mpkgs.nothing-fonts
    ]
    ++ lib.optional cfg.cursor.enable mpkgs.nothing-cursors
    ++ lib.optional cfg.icons mpkgs.nothing-icons
    ++ lib.optional cfg.cava mpkgs.nothing-cava;
    # cursor theme: Hyprland reads ~/.config/monolith/cursor (hypr/modules/environment.lua); GTK's "default"
    # theme (settings.ini) inherits it; GNOME-style settings and Qt follow the same name and size
    home.file = lib.mkIf cfg.cursor.enable {
      ".icons/Monolith-Dots".source = "${mpkgs.nothing-cursors}/share/icons/Monolith-Dots";
      ".icons/default/index.theme".text = "[Icon Theme]\nName=Default\nInherits=Monolith-Dots\n";
    };
    home.sessionVariables = lib.mkIf cfg.cursor.enable {
      XCURSOR_THEME = "Monolith-Dots";
      XCURSOR_SIZE = toString cfg.cursor.size;
    };
    # GTK (Nautilus included) takes the cursor and icon themes from these settings, through the settings
    # portal; they win over settings.ini, which keeps Adwaita for when the theme is off
    dconf.settings."org/gnome/desktop/interface" =
      lib.optionalAttrs cfg.cursor.enable {
        cursor-theme = "Monolith-Dots";
        cursor-size = cfg.cursor.size;
      }
      // lib.optionalAttrs cfg.icons { icon-theme = "Monolith-Dots-Icons"; };
    # fastfetch: replaces the shell's plain config (configs/.config/fastfetch) while the theme is on
    # (dev mode, programs.monolith.dev: these come from nix/nothing/ in the checkout, editable in place)
    xdg.configFile."fastfetch/config.jsonc" = lib.mkIf cfg.fastfetch {
      source = lib.mkForce (devLink "fastfetch" "nix/nothing/fastfetch.jsonc" ../nothing/fastfetch.jsonc);
    };
    xdg.configFile."fastfetch/nothing-logo.txt" = lib.mkIf cfg.fastfetch {
      source = devLink "fastfetch" "nix/nothing/fastfetch-logo.txt" ../nothing/fastfetch-logo.txt;
    };
    xdg.configFile."cava/config" = lib.mkIf cfg.cava { source = devLink "cava" "nix/nothing/cava.conf" ../nothing/cava.conf; };
    # `cava` with no arguments in a terminal opens the LED version; with arguments (or `command cava`) the
    # plain one, which uses the grey config above
    xdg.configFile."fish/functions/cava.fish" = lib.mkIf cfg.cava {
      text = ''
        # Generated by Home Manager (programs.monolith.nothingTheme.cava)
        function cava --wraps cava --description "cava as LEDs (MONOLITH Nothing theme)"
            if test (count $argv) -eq 0; and isatty stdout; and command -q monolith-cava
                monolith-cava
            else
                command cava $argv
            end
        end
      '';
    };
    xdg.configFile."monolith/cursor" = lib.mkIf cfg.cursor.enable {
      text = "Monolith-Dots ${toString cfg.cursor.size}\n";
    };
    xdg.configFile."monolith/nothing.json".text = builtins.toJSON {
      version = 1;
      # what the shell starts from; Settings > Themes > Nothing changes them at runtime
      defaults = {
        enabled = true;
        inherit (cfg) monochrome edgeGlow;
        ledSize = cfg.led.size;
        ledSpacing = cfg.led.spacing;
        ledShape = cfg.led.shape;
        wallpaperStyle = w.style;
        inherit (w) dither levels invert contrast brightness;
        inherit (colors) lit off background;
      };
      palette = lib.mapAttrs (_: c: "#${c}") tokens.palette;
      inherit (tokens) fonts motion;
      # build-time renderings: used by wallpaper-menu when the file and the look (key) match
      wallpapers = {
        dir = if rendered then "${wallpapers}" else "";
        key = if rendered then key else "";
        outputs = lib.attrNames w.outputs;
      };
    };
  };
}
